<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- _Imports.razor hanya berlaku untuk file .razor; baris ini membuat namespace
         Radzen tersedia juga di code-behind (.razor.cs). -->
    <Using Include="Radzen" />
    <!-- PrivateAssets: jangan mengalir ke host WASM yang tidak punya runtime pack AspNetCore.App. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" Version="12.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorTemplate.Shared\BlazorTemplate.Shared.csproj" />
  </ItemGroup>

</Project>
