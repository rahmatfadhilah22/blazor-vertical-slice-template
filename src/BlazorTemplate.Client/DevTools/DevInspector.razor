@using System.Reflection
@inherits BaseComponent
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Dev inspector: daftar route + komponen aplikasi beserta path file .razor-nya, supaya
 * pertanyaan "halaman ini ada di file mana?" tidak perlu grep. Hanya dirender di DEBUG
 * (MainLayout / PlainLayout), jadi tidak ada di build Release.
 *
 * Path diturunkan dari namespace (aturan proyek ini: namespace = folder). Kalau sebuah
 * file menyimpang, yang salah namespace-nya, bukan panel ini.
 *
 * Batasnya: Blazor tidak menandai DOM dengan komponen asalnya, jadi "klik elemen di
 * halaman lalu lompat ke komponennya" butuh data-* manual di setiap komponen. Panel ini
 * menjawab arah sebaliknya — dari route/nama komponen ke file.
 *@
<button class="app-dev-toggle" @onclick="() => _open = !_open" title="Dev: route &amp; komponen">
    <RadzenIcon Icon="code" />
</button>

@if (_open)
{
    <aside class="app-dev-panel">
        <header class="app-dev-head">
            <div class="app-dev-head-text">
                <strong>@(_tab == Tab.Api ? "API log" : "Route & komponen")</strong>
                <code class="app-dev-now">@CurrentPath</code>
            </div>
            <button class="app-dev-close" @onclick="() => _open = false" title="Tutup">&times;</button>
        </header>

        <div class="app-dev-tabs">
            <button class="app-dev-tab @(_tab == Tab.Route ? "is-active" : null)"
                    @onclick="() => _tab = Tab.Route">Route</button>
            <button class="app-dev-tab @(_tab == Tab.Api ? "is-active" : null)"
                    @onclick="() => _tab = Tab.Api">API @ApiLog.Entries.Count</button>
        </div>

        @if (_tab == Tab.Route)
        {
            <input type="text" class="rz-textbox app-dev-search" placeholder="Cari nama, route, atau file..."
                   @bind="_filter" @bind:event="oninput" />

            <div class="app-dev-list">
                @foreach (var group in Groups)
                {
                    <p class="app-dev-group">@group.Title (@group.Entries.Count)</p>
                    @foreach (var entry in group.Entries)
                    {
                        <button class="app-dev-row @(IsCurrent(entry) ? "is-current" : null)"
                                @onclick="() => CopyAsync(entry.Path)">
                            <span class="app-dev-name">
                                @entry.Name
                                @if (entry.Route is not null)
                                {
                                    <code class="app-dev-route">@entry.Route</code>
                                }
                            </span>
                            <span class="app-dev-path">@entry.Path</span>
                        </button>
                    }
                }

                @if (Groups.Count == 0)
                {
                    <p class="app-dev-empty">Tidak ada yang cocok dengan "@_filter".</p>
                }
            </div>

            <footer class="app-dev-foot">@(_copied ?? "Klik baris untuk menyalin path.")</footer>
        }
        else
        {
            <div class="app-dev-list">
                @if (ApiLog.Entries.Count == 0)
                {
                    <p class="app-dev-empty">Belum ada request.</p>
                }

                @foreach (var entry in ApiLog.Entries)
                {
                    <button class="app-dev-row @(entry.Status is null or >= 400 ? "is-error" : null)"
                            @onclick="() => Toggle(entry.Seq)">
                        <span class="app-dev-name">
                            <code class="app-dev-method">@entry.Method</code>
                            <span class="app-dev-status">@(entry.Status?.ToString() ?? "ERR")</span>
                            <span class="app-dev-ms">@entry.ElapsedMs ms · @entry.At.ToString("HH:mm:ss")</span>
                        </span>
                        <span class="app-dev-path">@ShortUrl(entry.Url)</span>
                    </button>

                    @if (_expanded == entry.Seq)
                    {
                        <div class="app-dev-detail">
                            @if (entry.Request is not null)
                            {
                                <p class="app-dev-label">Request</p>
                                <pre>@ApiLog.Pretty(entry.Request)</pre>
                            }
                            @if (entry.Response is not null)
                            {
                                <p class="app-dev-label">Response</p>
                                <pre>@ApiLog.Pretty(entry.Response)</pre>
                            }
                            @if (entry.Error is not null)
                            {
                                <p class="app-dev-label">Error</p>
                                <pre>@entry.Error</pre>
                            }
                        </div>
                    }
                }
            </div>

            <footer class="app-dev-foot">
                <button class="app-dev-clear" @onclick="ApiLog.Clear">Bersihkan</button>
                Klik baris untuk lihat body.
            </footer>
        }
    </aside>
}

@code {
    private bool _open;
    private string _filter = "";
    private string? _copied;

    private enum Tab { Route, Api }

    private Tab _tab;
    private int? _expanded;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ApiLog.Changed += OnApiLogChanged;
    }

    public override void Dispose()
    {
        ApiLog.Changed -= OnApiLogChanged;
        base.Dispose();
    }

    private void OnApiLogChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle(int seq) => _expanded = _expanded == seq ? null : seq;

    private static string ShortUrl(string url)
        => Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.PathAndQuery : url;

    private string CurrentPath => new Uri(Nav.Uri).PathAndQuery;

    /// <summary>Assembly + folder proyek. Path file diturunkan dari namespace.</summary>
    private static readonly (Assembly Assembly, string ProjectDir, string RootNamespace)[] Projects =
    [
        (typeof(CategoryGrid).Assembly, "src/BlazorTemplate.Client", "BlazorTemplate.Client"),
        (typeof(Button).Assembly, "src/BlazorTemplate.Shared", "BlazorTemplate.Shared"),
    ];

    private static readonly Entry[] All = Build();

    private sealed record Entry(string Name, string? Route, string Path);

    private sealed record Group(string Title, IReadOnlyList<Entry> Entries);

    private IReadOnlyList<Group> Groups
    {
        get
        {
            var matches = Filter(All).ToList();
            return new List<Group>
            {
                new("Halaman", matches.Where(e => e.Route is not null).ToList()),
                new("Komponen", matches.Where(e => e.Route is null).ToList()),
            }.Where(g => g.Entries.Count > 0).ToList();
        }
    }

    private IEnumerable<Entry> Filter(IEnumerable<Entry> entries)
    {
        if (string.IsNullOrWhiteSpace(_filter))
            return entries;

        var needle = _filter.Trim();
        return entries.Where(e =>
            e.Name.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
            e.Path.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
            (e.Route?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    // Route parameter ("{id}") belum didukung: belum ada halaman detail. Tambahkan
    // pencocokan segmen saat halaman seperti itu ada.
    private bool IsCurrent(Entry entry) =>
        entry.Route is not null &&
        ("/" + entry.Route.TrimStart('/')).Equals(CurrentPath, StringComparison.OrdinalIgnoreCase);

    private static Entry[] Build()
    {
        var entries = new List<Entry>();
        foreach (var (assembly, projectDir, rootNamespace) in Projects)
        {
            foreach (var type in Types(assembly))
            {
                if (type.IsAbstract || type.IsInterface || type.IsNested)
                    continue;

                var routes = type.GetCustomAttributes<RouteAttribute>(inherit: false).ToArray();
                var name = type.Name.Split('`')[0];
                var path = SourcePath(type, projectDir, rootNamespace);

                if (routes.Length > 0)
                {
                    entries.AddRange(routes.Select(route => new Entry(name, route.Template, path)));
                    continue;
                }

                // Hanya komponen Razor milik aplikasi: Localizer/ApiClient bukan komponen
                // dan tidak punya file .razor.
                if (typeof(IComponent).IsAssignableFrom(type))
                    entries.Add(new Entry(name, null, path));
            }
        }

        return [.. entries.OrderBy(e => e.Name)];
    }

    private static IEnumerable<Type> Types(Assembly assembly)
    {
        try
        {
            return assembly.GetTypes();
        }
        catch (ReflectionTypeLoadException ex)
        {
            // Satu tipe gagal dimuat tidak boleh menyembunyikan sisanya.
            return ex.Types.OfType<Type>();
        }
    }

    private static string SourcePath(Type type, string projectDir, string rootNamespace)
    {
        var ns = type.Namespace ?? "";
        var folder = ns.StartsWith(rootNamespace, StringComparison.Ordinal)
            ? ns[rootNamespace.Length..].TrimStart('.')
            : "";

        var path = folder.Replace('.', '/');
        var fileName = type.Name.Split('`')[0] + ".razor";

        return string.IsNullOrEmpty(path)
            ? $"{projectDir}/{fileName}"
            : $"{projectDir}/{path}/{fileName}";
    }

    private async Task CopyAsync(string path)
    {
        // Radzen sudah punya pembungkus clipboard yang mengembalikan bool, jadi tidak perlu
        // JS sendiri. Gagal = permission/fokus ditolak browser; path tetap terlihat di baris.
        var copied = await JS.InvokeAsync<bool>("Radzen.copyToClipboard", path);
        _copied = copied
            ? $"Tersalin: {path}"
            : "Clipboard ditolak browser — salin manual dari baris di atas.";
    }
}
