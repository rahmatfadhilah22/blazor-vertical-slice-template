@inherits BaseComponent
@* Dialog form kategori — hanya field. Kerangka (validasi, grid, footer) ada di FormDialog. *@
<FormDialog TItem="Category" Data="_model" Columns="2" IsBusy="@Guard.Busy" ErrorMessage="@_message" Submit="SaveAsync">
    <FormTextBox Label="@L["category.nameLabel"]" Name="CategoryName" Required MaxLength="15"
                 Placeholder="@L["category.nameHint"]"
                 @bind-Value="_model.CategoryName"
                 Error="@ErrorFor("CategoryName")" />

    <FormTextArea Label="@L["category.description"]" Name="Description" FullWidth Rows="3"
                  Placeholder="@L["common.optional"]"
                  @bind-Value="_model.Description"
                  Error="@ErrorFor("Description")" />
</FormDialog>
