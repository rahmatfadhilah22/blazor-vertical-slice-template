@inherits BaseComponent
<DataGrid @ref="_grid"
          TItem="Category"
          AllowSearch
          AllowSelection
          SearchPlaceholder="Cari nama atau deskripsi..."
          LoadData="LoadAsync"
          SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="Tambah" Icon="add" Variant="ButtonVariant.Success" 
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@(_grid?.SelectedCount is > 0 ? $"Hapus ({_grid.SelectedCount})" : "Hapus")"
                Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>

    <ChildContent>  
        <RadzenDataGridColumn TItem="Category" Property="CategoryID" Title="ID" Width="70px" />
        <RadzenDataGridColumn TItem="Category" Property="CategoryName" Title="Nama" Width="220px" />
        <RadzenDataGridColumn TItem="Category" Property="Description" Title="Deskripsi" />
        <RadzenDataGridColumn TItem="Category" Context="category" Title="" Sortable="false"
                              Filterable="false" Width="70px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small"
                        Click="@(() => OpenFormAsync(category))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
