@inherits BaseComponent
<DataGrid @ref="_grid" TItem="CustomerDemographic" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.customerDemographics"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="CustomerDemographic" Property="CustomerTypeID"
                              Title="@L["field.customerTypeID"]" Width="180px" />
        <RadzenDataGridColumn TItem="CustomerDemographic" Property="CustomerDesc"
                              Title="@L["field.customerDesc"]" />
        <RadzenDataGridColumn TItem="CustomerDemographic" Context="demographic" Title="@L["common.action"]"
                              Sortable="false" Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(demographic))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
