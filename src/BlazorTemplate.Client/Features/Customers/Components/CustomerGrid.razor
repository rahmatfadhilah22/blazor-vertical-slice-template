@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Customer" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.customers"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Customer" Property="CustomerID" Title="@L["field.customerID"]" Width="10%" />
        <RadzenDataGridColumn TItem="Customer" Property="CompanyName" Title="@L["field.companyName"]" Width="30%" />
        <RadzenDataGridColumn TItem="Customer" Property="ContactName" Title="@L["field.contactName"]" Width="25%" />
        <RadzenDataGridColumn TItem="Customer" Property="Country" Title="@L["field.country"]" Width="10%" />
        <RadzenDataGridColumn TItem="Customer" Property="Phone" Title="@L["field.phone"]" Width="10%" />
        <RadzenDataGridColumn TItem="Customer" Context="customer" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(customer))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
