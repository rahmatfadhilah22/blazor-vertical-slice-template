@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Customer" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.customers"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Customer" Property="CustomerID" Title="@L["field.customerID"]" Width="110px" />
        <RadzenDataGridColumn TItem="Customer" Property="CompanyName" Title="@L["field.companyName"]" />
        <RadzenDataGridColumn TItem="Customer" Property="ContactName" Title="@L["field.contactName"]" Width="180px" />
        <RadzenDataGridColumn TItem="Customer" Property="Country" Title="@L["field.country"]" Width="110px" />
        <RadzenDataGridColumn TItem="Customer" Property="Phone" Title="@L["field.phone"]" Width="140px" />
        <RadzenDataGridColumn TItem="Customer" Context="customer" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(customer))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
