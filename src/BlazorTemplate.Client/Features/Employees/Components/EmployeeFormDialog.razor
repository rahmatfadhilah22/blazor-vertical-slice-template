@inherits BaseComponent
<FormDialog TItem="Employee" Data="_model" Columns="2" IsBusy="@Guard.Busy"
            ErrorMessage="@_message" Submit="SaveAsync">
    <FormTextBox Label="@L["field.lastName"]" Name="LastName" Required MaxLength="20"
                 @bind-Value="_model.LastName" Error="@ErrorFor("LastName")" />
    <FormTextBox Label="@L["field.firstName"]" Name="FirstName" Required MaxLength="10"
                 @bind-Value="_model.FirstName" Error="@ErrorFor("FirstName")" />
    <FormTextBox Label="@L["field.title"]" Name="Title" MaxLength="30"
                 @bind-Value="_model.Title" Error="@ErrorFor("Title")" />
    <FormTextBox Label="@L["field.titleOfCourtesy"]" Name="TitleOfCourtesy" MaxLength="25"
                 @bind-Value="_model.TitleOfCourtesy" Error="@ErrorFor("TitleOfCourtesy")" />
    <FormDatePicker Label="@L["field.birthDate"]" Name="BirthDate" TValue="DateOnly?"
                    @bind-Value="_model.BirthDate" Error="@ErrorFor("BirthDate")" />
    <FormDatePicker Label="@L["field.hireDate"]" Name="HireDate" TValue="DateOnly?"
                    @bind-Value="_model.HireDate" Error="@ErrorFor("HireDate")" />
    <FormDropDown Label="@L["field.reportsTo"]" Name="ReportsTo" TValue="int?"
                  Data="@_employees" TextProperty="LastName" ValueProperty="EmployeeID"
                  @bind-Value="_model.ReportsTo" Error="@ErrorFor("ReportsTo")" />
    <FormTextBox Label="@L["field.extension"]" Name="Extension" MaxLength="4"
                 @bind-Value="_model.Extension" Error="@ErrorFor("Extension")" />
    <FormTextBox Label="@L["field.address"]" Name="Address" MaxLength="60"
                 @bind-Value="_model.Address" Error="@ErrorFor("Address")" />
    <FormTextBox Label="@L["field.city"]" Name="City" MaxLength="15"
                 @bind-Value="_model.City" Error="@ErrorFor("City")" />
    <FormTextBox Label="@L["field.region"]" Name="Region" MaxLength="15"
                 @bind-Value="_model.Region" Error="@ErrorFor("Region")" />
    <FormTextBox Label="@L["field.postalCode"]" Name="PostalCode" MaxLength="10"
                 @bind-Value="_model.PostalCode" Error="@ErrorFor("PostalCode")" />
    <FormTextBox Label="@L["field.country"]" Name="Country" MaxLength="15"
                 @bind-Value="_model.Country" Error="@ErrorFor("Country")" />
    <FormTextBox Label="@L["field.homePhone"]" Name="HomePhone" MaxLength="24"
                 @bind-Value="_model.HomePhone" Error="@ErrorFor("HomePhone")" />
    <FormTextBox Label="@L["field.photoPath"]" Name="PhotoPath" MaxLength="255"
                 @bind-Value="_model.PhotoPath" Error="@ErrorFor("PhotoPath")" />
    <FormTextArea Label="@L["field.notes"]" Name="Notes" Rows="3" MaxLength="2000" FullWidth
                  @bind-Value="_model.Notes" Error="@ErrorFor("Notes")" />
</FormDialog>
