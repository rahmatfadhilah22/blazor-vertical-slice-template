@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Employee" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.employees"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Employee" Property="EmployeeID" Title="ID" Width="8%" />
        <RadzenDataGridColumn TItem="Employee" Property="LastName" Title="@L["field.lastName"]" Width="22%" />
        <RadzenDataGridColumn TItem="Employee" Property="FirstName" Title="@L["field.firstName"]" Width="22%" />
        <RadzenDataGridColumn TItem="Employee" Property="Title" Title="@L["field.title"]" Width="25%" />
        <RadzenDataGridColumn TItem="Employee" Property="Country" Title="@L["field.country"]" Width="8%" />
        <RadzenDataGridColumn TItem="Employee" Context="employee" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(employee))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
