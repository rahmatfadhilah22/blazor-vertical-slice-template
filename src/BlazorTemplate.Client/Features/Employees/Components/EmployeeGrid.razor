@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Employee" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.employees"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Employee" Property="EmployeeID" Title="ID" Width="72px" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn TItem="Employee" Property="LastName" Title="@L["field.lastName"]" Width="140px" />
        <RadzenDataGridColumn TItem="Employee" Property="FirstName" Title="@L["field.firstName"]" Width="120px" />
        <RadzenDataGridColumn TItem="Employee" Property="Title" Title="@L["field.title"]" />
        <RadzenDataGridColumn TItem="Employee" Property="Country" Title="@L["field.country"]" Width="110px" />
        <RadzenDataGridColumn TItem="Employee" Context="employee" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(employee))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
