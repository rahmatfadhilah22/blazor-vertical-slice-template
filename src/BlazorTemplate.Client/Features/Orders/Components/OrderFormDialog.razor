@inherits FormDialogBase<Order>
<FormDialog TItem="Order" Data="_model" Columns="2" IsBusy="@Guard.Busy"
            ErrorMessage="@_message" Submit="SaveAsync">
    <FormDropDown Label="@L["field.customerID"]" Name="CustomerID" TValue="string?"
                  Data="@_customers" TextProperty="CompanyName" ValueProperty="CustomerID"
                  LoadData="LoadCustomersAsync"
                  @bind-Value="_model.CustomerID" Error="@ErrorFor("CustomerID")" />
    <FormDropDown Label="@L["field.employeeID"]" Name="EmployeeID" TValue="int?"
                  Data="@_employees" TextProperty="LastName" ValueProperty="EmployeeID"
                  LoadData="LoadEmployeesAsync"
                  @bind-Value="_model.EmployeeID" Error="@ErrorFor("EmployeeID")" />
    <FormDatePicker Label="@L["field.orderDate"]" Name="OrderDate" TValue="DateOnly?"
                    @bind-Value="_model.OrderDate" Error="@ErrorFor("OrderDate")" />
    <FormDatePicker Label="@L["field.requiredDate"]" Name="RequiredDate" TValue="DateOnly?"
                    @bind-Value="_model.RequiredDate" Error="@ErrorFor("RequiredDate")" />
    <FormDatePicker Label="@L["field.shippedDate"]" Name="ShippedDate" TValue="DateOnly?"
                    @bind-Value="_model.ShippedDate" Error="@ErrorFor("ShippedDate")" />
    <FormDropDown Label="@L["field.shipVia"]" Name="ShipVia" TValue="int?"
                  Data="@_shippers" TextProperty="CompanyName" ValueProperty="ShipperID"
                  LoadData="LoadShippersAsync"
                  @bind-Value="_model.ShipVia" Error="@ErrorFor("ShipVia")" />
    <FormNumeric Label="@L["field.freight"]" Name="Freight" TNumber="decimal?"
                 @bind-Value="_model.Freight" Error="@ErrorFor("Freight")" />
    <FormTextBox Label="@L["field.shipName"]" Name="ShipName" MaxLength="40"
                 @bind-Value="_model.ShipName" Error="@ErrorFor("ShipName")" />
    <FormTextBox Label="@L["field.shipAddress"]" Name="ShipAddress" MaxLength="60"
                 @bind-Value="_model.ShipAddress" Error="@ErrorFor("ShipAddress")" />
    <FormTextBox Label="@L["field.shipCity"]" Name="ShipCity" MaxLength="15"
                 @bind-Value="_model.ShipCity" Error="@ErrorFor("ShipCity")" />
    <FormTextBox Label="@L["field.shipRegion"]" Name="ShipRegion" MaxLength="15"
                 @bind-Value="_model.ShipRegion" Error="@ErrorFor("ShipRegion")" />
    <FormTextBox Label="@L["field.shipPostalCode"]" Name="ShipPostalCode" MaxLength="10"
                 @bind-Value="_model.ShipPostalCode" Error="@ErrorFor("ShipPostalCode")" />
    <FormTextBox Label="@L["field.shipCountry"]" Name="ShipCountry" MaxLength="15"
                 @bind-Value="_model.ShipCountry" Error="@ErrorFor("ShipCountry")" />
</FormDialog>
