@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Order" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.orders"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Order" Property="OrderID" Title="ID" Width="8%" />
        <RadzenDataGridColumn TItem="Order" Property="CustomerID" Title="@L["field.customerID"]" Width="14%" />
        <RadzenDataGridColumn TItem="Order" Property="EmployeeID" Title="@L["field.employeeID"]" Width="12%" />
        <RadzenDataGridColumn TItem="Order" Property="OrderDate" Title="@L["field.orderDate"]" Width="16%" FormatString="{0:yyyy-MM-dd}" />
        <RadzenDataGridColumn TItem="Order" Property="ShipVia" Title="@L["field.shipVia"]" Width="12%" />
        <RadzenDataGridColumn TItem="Order" Property="Freight" Title="@L["field.freight"]" Width="13%" />
        <RadzenDataGridColumn TItem="Order" Context="order" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(order))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
