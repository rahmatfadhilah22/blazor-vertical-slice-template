@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Product" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.products"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Product" Property="ProductID" Title="ID" Width="8%" />
        <RadzenDataGridColumn TItem="Product" Property="ProductName" Title="@L["field.productName"]" Width="34%" />
        <RadzenDataGridColumn TItem="Product" Property="UnitPrice" Title="@L["field.unitPrice"]" Width="14%" />
        <RadzenDataGridColumn TItem="Product" Property="UnitsInStock" Title="@L["field.unitsInStock"]" Width="14%" />
        <RadzenDataGridColumn TItem="Product" Property="Discontinued" Title="@L["field.discontinued"]" Width="15%" />
        <RadzenDataGridColumn TItem="Product" Context="product" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(product))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
