@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Product" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.products"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Product" Property="ProductID" Title="ID" Width="72px" />
        <RadzenDataGridColumn TItem="Product" Property="ProductName" Title="@L["field.productName"]" />
        <RadzenDataGridColumn TItem="Product" Property="UnitPrice" Title="@L["field.unitPrice"]" Width="120px"
                              TextAlign="TextAlign.Right" FormatString="{0:C2}" FormatProvider="@Formats.Usd" />
        <RadzenDataGridColumn TItem="Product" Property="UnitsInStock" Title="@L["field.unitsInStock"]" Width="130px"
                              TextAlign="TextAlign.Right" FormatString="{0:N0}" />
        <RadzenDataGridColumn TItem="Product" Property="Discontinued" Title="@L["field.discontinued"]" Width="140px"
                              TextAlign="TextAlign.Center">
            <Template Context="product">
                <span class="app-badge @(product.Discontinued ? "app-badge-danger" : "app-badge-success")">
                    @(product.Discontinued ? L["common.yes"] : L["common.no"])
                </span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Product" Context="product" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(product))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
