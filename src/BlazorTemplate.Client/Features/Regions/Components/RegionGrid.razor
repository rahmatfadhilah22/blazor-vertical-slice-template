@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Region" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.regions"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Region" Property="RegionID" Title="@L["field.regionID"]" Width="15%" />
        <RadzenDataGridColumn TItem="Region" Property="RegionDescription" Title="@L["field.regionDescription"]" Width="70%" />
        <RadzenDataGridColumn TItem="Region" Context="region" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(region))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
