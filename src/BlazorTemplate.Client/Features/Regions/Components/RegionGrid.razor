@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Region" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.regions"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Region" Property="RegionID" Title="@L["field.regionID"]" Width="100px" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn TItem="Region" Property="RegionDescription" Title="@L["field.regionDescription"]" />
        <RadzenDataGridColumn TItem="Region" Context="region" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(region))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
