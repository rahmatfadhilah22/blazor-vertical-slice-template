@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Territory" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.territories"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Territory" Property="TerritoryID" Title="@L["field.territoryID"]" Width="140px" />
        <RadzenDataGridColumn TItem="Territory" Property="TerritoryDescription"
                              Title="@L["field.territoryDescription"]" />
        <RadzenDataGridColumn TItem="Territory" Property="RegionDescription" Title="@L["field.region"]" Width="140px" />
        <RadzenDataGridColumn TItem="Territory" Context="territory" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(territory))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
