@inherits BaseComponent
<DataGrid @ref="_grid" TItem="Territory" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.territories"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="Territory" Property="TerritoryID" Title="@L["field.territoryID"]" Width="20%" />
        <RadzenDataGridColumn TItem="Territory" Property="TerritoryDescription"
                              Title="@L["field.territoryDescription"]" Width="45%" />
        <RadzenDataGridColumn TItem="Territory" Property="RegionID" Title="@L["field.region"]" Width="20%" />
        <RadzenDataGridColumn TItem="Territory" Context="territory" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(territory))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
