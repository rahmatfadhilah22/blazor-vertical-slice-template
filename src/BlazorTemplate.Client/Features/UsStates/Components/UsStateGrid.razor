@inherits BaseComponent
<DataGrid @ref="_grid" TItem="UsState" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.usStates"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Success"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="ButtonVariant.Danger"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="UsState" Property="StateID" Title="ID" Width="10%" />
        <RadzenDataGridColumn TItem="UsState" Property="StateName" Title="@L["field.stateName"]" Width="40%" />
        <RadzenDataGridColumn TItem="UsState" Property="StateAbbr" Title="@L["field.stateAbbr"]" Width="15%" />
        <RadzenDataGridColumn TItem="UsState" Property="StateRegion" Title="@L["field.stateRegion"]" Width="20%" />
        <RadzenDataGridColumn TItem="UsState" Context="state" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="15%" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(state))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
