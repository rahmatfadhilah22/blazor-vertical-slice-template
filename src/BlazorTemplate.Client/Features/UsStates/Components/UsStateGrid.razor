@inherits BaseComponent
<DataGrid @ref="_grid" TItem="UsState" AllowSearch AllowSelection
          SearchPlaceholder="@L.Format("common.searchFor", L["entity.usStates"])"
          LoadData="LoadAsync" SelectionChanged="StateHasChanged">
    <Toolbar>
        <Button Text="@L["common.add"]" Icon="add" Variant="ButtonVariant.Primary"
                Click="@(() => OpenFormAsync(null))" />
        <Button Text="@DeleteText" Icon="delete" Variant="@(_grid?.SelectedCount is > 0 ? ButtonVariant.Danger : ButtonVariant.Light)"
                Disabled="@(_grid?.SelectedCount is not > 0)" Click="DeleteSelectedAsync" />
    </Toolbar>
    <ChildContent>
        <RadzenDataGridColumn TItem="UsState" Property="StateID" Title="ID" Width="72px" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn TItem="UsState" Property="StateName" Title="@L["field.stateName"]" />
        <RadzenDataGridColumn TItem="UsState" Property="StateAbbr" Title="@L["field.stateAbbr"]" Width="90px" />
        <RadzenDataGridColumn TItem="UsState" Property="StateRegion" Title="@L["field.stateRegion"]" Width="160px" />
        <RadzenDataGridColumn TItem="UsState" Context="state" Title="@L["common.action"]" Sortable="false"
                              Filterable="false" Width="88px" TextAlign="TextAlign.Center">
            <Template>
                <Button Icon="edit" Variant="ButtonVariant.Light" AriaLabel="@L["common.edit"]" Size="ButtonSize.Small" Click="@(() => OpenFormAsync(state))" />
            </Template>
        </RadzenDataGridColumn>
    </ChildContent>
</DataGrid>
