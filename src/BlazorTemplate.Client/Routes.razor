<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        @* Layout sendiri, bukan MainLayout: alamat yang salah tidak punya menu aktif,
           dan sidebar di sana hanya menyisakan ruang kosong yang membingungkan. *@
        <LayoutView Layout="@typeof(PlainLayout)">
            <PageNotFound />
        </LayoutView>
    </NotFound>
</Router>
