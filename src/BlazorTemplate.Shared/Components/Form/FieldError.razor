@* Pesan error di bawah field. role="alert" supaya screen reader mengumumkannya saat
   muncul setelah submit; CSS: Radzen 12 tidak punya .rz-text-danger / .rz-text-sm,
   yang benar .rz-color-danger + .rz-text-caption. *@
@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="rz-color-danger rz-text-caption" role="alert">@Message</div>
}

@code {
    [Parameter] public string? Message { get; set; }
}
