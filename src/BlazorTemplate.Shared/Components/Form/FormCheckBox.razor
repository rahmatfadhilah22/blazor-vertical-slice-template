@inherits FormInputBase<bool>
@* Checkbox berlabel + error server. Label membungkus kontrol, jadi klik teks ikut mencentang. *@
<FormField Label="@Label" Error="@Error" FullWidth="@FullWidth">
    <RadzenCheckBox TValue="bool" Name="@FieldName" Value="@Value" ValueChanged="@ValueChanged" Disabled="@Disabled" />
</FormField>
