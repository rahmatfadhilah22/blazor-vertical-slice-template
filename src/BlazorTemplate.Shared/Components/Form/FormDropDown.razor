@typeparam TValue
@inherits FormInputBase<TValue>
@* Dropdown berlabel + error + validator wajib. Data/TextProperty/ValueProperty mengikuti
   API Radzen apa adanya; pemuat opsi tetap tanggung jawab pemanggil (lihat dialog yang
   memanggil GetRows dengan pageSize 100). *@
<FormField Label="@Label" Error="@Error" FullWidth="@FullWidth">
    <RadzenDropDown TValue="TValue" Name="@FieldName" Value="@Value" ValueChanged="@ValueChanged"
                    Data="@Data" TextProperty="@TextProperty" ValueProperty="@ValueProperty"
                    AllowClear="@AllowClear" AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    LoadData="@LoadData"
                    Placeholder="@(Placeholder ?? L["common.optional"])" Disabled="@Disabled" />
    @if (Required)
    {
        <RadzenRequiredValidator Component="@FieldName" Text="@L.Format("common.required", Label)" />
    }
</FormField>

@code {
    [Parameter] public IEnumerable<object>? Data { get; set; }
    [Parameter, EditorRequired] public string TextProperty { get; set; } = "";
    [Parameter, EditorRequired] public string ValueProperty { get; set; } = "";
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>
    /// Opsional. Kalau diisi, pencarian dropdown dikirim ke sini (args.Filter) dan
    /// pemanggil mengisi ulang Data dari API — bukan filter lokal atas data yang sudah dimuat.
    /// </summary>
    [Parameter] public EventCallback<LoadDataArgs> LoadData { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
}
