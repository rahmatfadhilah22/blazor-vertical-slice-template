@namespace BlazorTemplate.Shared.Components
@inherits FormInputBase<bool>
@* Switch/toggle on-off berlabel + error server. Sama dengan RadzenSwitch, hanya beda nama makna. *@
<FormField Label="@Label" Error="@Error" FullWidth="@FullWidth">
    <RadzenSwitch @bind-Value="Value" Disabled="@Disabled" />
</FormField>
