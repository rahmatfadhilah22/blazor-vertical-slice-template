@* Judul halaman + area aksi (tombol tambah, filter, dsb). Dipakai di setiap halaman fitur. *@
<div class="rz-display-flex rz-justify-content-space-between rz-align-items-center rz-mb-4">
    <div>
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="app-page-title rz-mb-0">@Title</RadzenText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-secondary-color rz-mb-0">@Subtitle</RadzenText>
        }
    </div>
    @if (Actions is not null)
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            @Actions
        </RadzenStack>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
