@* Satu tab di dalam <TabView>. Membungkus RadzenTabsItem supaya pemakai tidak
   perlu tahu nama komponen Radzen. *@
<RadzenTabsItem Text="@Text" Icon="@Icon" Disabled="@Disabled">
    @ChildContent
</RadzenTabsItem>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
